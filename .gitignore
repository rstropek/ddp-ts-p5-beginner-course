# Quarto build output
/_output/
/.quarto/

# Per-document intermediates Quarto writes next to a .qmd during PDF rendering
# (converted SVGs, rasterized Mermaid diagrams, etc.)
*_files/

# Auxiliary LaTeX files Quarto may leave behind on failed PDF renders
*.aux
*.log
*.out
*.toc

# Evaluation results
/eval-result*/